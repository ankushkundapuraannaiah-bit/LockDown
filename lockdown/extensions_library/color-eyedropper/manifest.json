{
  "manifest_version": 3,
  "name": "Web Color Eyedropper",
  "version": "1.1.0",
  "description": "Sample and copy hex color values",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}