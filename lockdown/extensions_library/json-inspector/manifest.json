{
  "manifest_version": 3,
  "name": "JSON Tree Inspector",
  "version": "1.3.0",
  "description": "Auto-detect and format JSON endpoints",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}