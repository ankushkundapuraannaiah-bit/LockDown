{
  "manifest_version": 3,
  "name": "Web Markdown Clipper",
  "version": "1.3.0",
  "description": "Extracts markdown from webpages",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}