{
  "manifest_version": 3,
  "name": "Tab Memory Saver",
  "version": "1.0.4",
  "description": "Saves system resources on hidden tabs",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}